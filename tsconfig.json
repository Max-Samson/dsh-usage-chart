{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["./types/cordis.d.ts"],
      "@deepseek-ai/dsh-client-runtime/client": ["./types/dsh-client-runtime.d.ts"]
    }
  },
  "include": ["src", "types"]
}
